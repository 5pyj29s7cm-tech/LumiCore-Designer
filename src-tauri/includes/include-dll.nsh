; Auto-generated by copy-webview2-dll.mjs
; Lumi Designer keeps its stable installer identity, so normal in-place upgrades
; remain supported. User data is migrated separately under the backend lease.
!define LUMI_INSTALLER_HOOK_DIR "${__FILEDIR__}"
!macro NSIS_HOOK_PREINSTALL
!macroend

; Installs WebView2Loader.dll alongside the new EXE.
!macro NSIS_HOOK_POSTINSTALL
  File "/oname=$INSTDIR\WebView2Loader.dll" "${LUMI_INSTALLER_HOOK_DIR}\..\..\desktop-resources\WebView2Loader.dll"
!macroend
